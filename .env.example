# LLM Configuration
# For local LLM (LM Studio):
OPENAI_API_BASE=http://localhost:1234/v1
OPENAI_API_KEY=local
OPENAI_MODEL=qwen/qwen3-vl-8b

# For OpenAI:
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o

# Browser Configuration
BROWSER_USE_HEADLESS=false

# Logging
BROWSER_USE_LOGGING_LEVEL=info

# Job Applier Settings
JOB_APPLIER_PORT=8000
JOB_APPLIER_DB_PATH=./job_applier.db
JOB_APPLIER_ARTIFACTS_DIR=./artifacts
JOB_APPLIER_PROFILE_PATH=./profile.json
JOB_APPLIER_MAX_STEPS=100
JOB_APPLIER_MAX_HISTORY=10
JOB_APPLIER_PLATFORM_HANDLERS=1
JOB_APPLIER_WORKDAY_DETERMINISTIC=1
JOB_APPLIER_WORKDAY_FALLBACK_LLM=1

# Deprecated - JSON queue (for migration only)
# JOB_APPLIER_QUEUE_PATH=./job_queue.json

