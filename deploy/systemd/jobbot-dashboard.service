[Unit]
Description=JobBot local dashboard
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/git/auto-job-applier
Environment=JOBBOT_CONFIG=%h/.config/jobbot/runtime.json
EnvironmentFile=-%h/.config/jobbot/runtime.env
ExecStart=%h/git/auto-job-applier/.venv/bin/python -m job_applier.queue_runtime serve
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=default.target
